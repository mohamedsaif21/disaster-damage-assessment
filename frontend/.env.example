# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project URL and public anon key.
# These are the only Supabase values the browser may hold: the anon
# key is designed to be public, and every protected row is still
# guarded by backend ownership checks.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY, the database password or any
# backend secret here. Signed asset URLs are generated by the backend.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key